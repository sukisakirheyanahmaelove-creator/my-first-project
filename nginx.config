‎worker_processes auto; events { worker_connections 1024; } http { include /etc/nginx/mime.types; default_type application/octet-stream; # Basic performance settings sendfile on; keepalive_timeout 65; server { listen 80; server_name localhost; # Root directory kung saan nakalagay ang iyong files root /usr/share/nginx/html; index index.html; location / { try_files $uri $uri/ /index.html; } # Error pages error_page 500 502 503 504 /50x.html; location = /50x.html { root /usr/share/nginx/html; } } } 
